+def record_identity(document,expected_id,*,draft=False,require_latest=False,prefix='PUBLIC_NEW_RECORD'):
+    """Bind modern identity independently of metadata and attachment equality."""
+    require(type(document) is dict and type(expected_id) is str
+            and re.fullmatch(r'[1-9][0-9]*',expected_id) is not None
+            and document.get('id')==expected_id
+            and document.get('parent',{}).get('id')==PARENT_ID,
+            prefix+'_IDENTITY_DIFFERS')
+    require(document.get('is_draft') is draft and document.get('is_published') is (not draft),
+            prefix+'_STATE_DIFFERS')
+    require(str(document.get('parent',{}).get('access',{}).get('owned_by',{}).get('user'))==str(EXPECTED_OWNER),
+            prefix+'_OWNER_DIFFERS')
+    require(document.get('parent',{}).get('pids',{}).get('doi',{}).get('identifier')=='10.5281/zenodo.'+PARENT_ID,
+            prefix+'_CONCEPT_DOI_DIFFERS')
+    pids=document.get('pids',{})
+    require(type(pids) is dict,prefix+'_PIDS_SHAPE_DIFFERS')
+    if not draft or 'doi' in pids:
+        require(type(pids.get('doi')) is dict
+                and pids['doi'].get('identifier')=='10.5281/zenodo.'+expected_id,
+                prefix+'_VERSION_DOI_DIFFERS')
+    if draft:
+        require(document.get('versions',{}).get('is_latest_draft') is True,
+                prefix+'_NOT_LATEST_DRAFT')
+    elif require_latest:
+        require(document.get('versions',{}).get('is_latest') is True,
+                prefix+'_NOT_LATEST_PUBLIC')
+    return True
 
